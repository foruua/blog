# ───────────────────────── 站点 ─────────────────────────
HOST=127.0.0.1
PORT=8787
# 生产必须改成 production。不是 production 时：进程内看门狗、日志轮转、资源精简、
# 监控鉴权（/healthz 的内部字段）全部停在开发档 —— 不报错，只是不生效。
NODE_ENV=development
# 绝对链接（RSS / sitemap / canonical / 通知邮件）的源。生产环境可只配 SITE_DOMAIN，
# SITE_URL 会默认成 https://<SITE_DOMAIN>；两者都缺会指向占位域名并告警。
# 开发时留空即可（默认 http://HOST:PORT）；这一行别跟着复制到生产。
# SITE_URL=https://example.com
# SITE_DOMAIN=example.com
SITE_TITLE=我的博客
SITE_AUTHOR=博主
# 博主邮箱：只用于给作者评论算 Gravatar 头像，不参与收发信、不公开。
# SITE_EMAIL=me@example.com
SITE_DESC=写代码，也写字。
SITE_LANG=zh-CN
# 页头印记；默认取 SITE_DOMAIN。
# SITE_MARK=example.com
# SITE_ICP=京ICP备00000000号
# 公安联网备案号：与 ICP 并列显示在页脚，末尾那串数字自动拼成官方查询页的链接。
# SITE_POLICE=京公网安备11000000000000号
SITE_TZ_OFFSET=+08:00

# ───────────────────────── 目录 ─────────────────────────
# 默认都在项目内。自定义 DATA_DIR 时，数据库、上传、头像缓存、备份默认跟着它移动。
# DATA_DIR=/absolute/path/to/data
# CONTENT_DIR=/absolute/path/to/content
# BACKUP_DIR=/absolute/path/to/backups
# UPLOADS_DIR=/absolute/path/to/uploads
# DB_FILE=/absolute/path/to/blog.db
# AVATAR_CACHE_DIR=/absolute/path/to/avatars
# 主题目录；默认项目根目录 themes/。所有主题都在这里，没有内置/用户安装之分。
# THEMES_DIR=/absolute/path/to/themes

# ─────────────────────── 加密密钥 ───────────────────────
# 评论邮箱与 SMTP 密码的加密密钥。不要放进数据库或备份。
# 默认保存在 DATA_DIR/.app-secret（600）；也可以直接用环境变量或指定文件：
# APP_SECRET=一串至少 32 字节的随机值
# APP_SECRET_FILE=/absolute/path/to/app-secret

# ─────────────────────── 代理与上传 ───────────────────────
# 仅当直连对端是下面列出的可信代理时，才采信 X-Forwarded-For。
TRUST_PROXY=false
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# 只在本机 https 调试时打开：后台会话 cookie 不带 Secure。
# COOKIE_INSECURE=false
# 单文件上传上限（字节）。默认不限制；要恢复上限就设正数（8388608 = 8MB）。仅约束 raw 流式上传。
# MAX_UPLOAD_BYTES=8388608
# 旧 multipart 表单整块读入内存，因此单独限制（默认 33554432 = 32MB）；新前端走 raw 路径，不受此项影响。
# MAX_MULTIPART_UPLOAD_BYTES=33554432
# 图片解码像素上限（默认 8000 万；动画 GIF/WebP 按全部帧的像素总量计），过小会拒高像素照片。
# MAX_INPUT_PIXELS=80000000
# 同时处理的上传数（raw 上传流式落临时文件；旧 multipart 表单仍整块读内存）。
# MAX_CONCURRENT_UPLOADS=2
# 匿名 HTML 页面缓存秒数（默认 60；0 = 关闭）。内容/评论/设置/媒体/主题变化会立即失效。
# HTML_CACHE_TTL_MS=60000

# ───────────────────────── 友圈 ─────────────────────────
# 0 关闭自动刷新，下限 5 分钟。
FEED_REFRESH_MS=1800000
# 每个源在库里保留多少条。
FEED_KEEP=20
# FEED_TIMEOUT_MS=8000
# FEED_MAX_BYTES=2097152
# 允许抓内网地址，只应在本机测试时打开。
FEED_ALLOW_PRIVATE=false
# TUN/fake-IP 环境用真实公网 DNS 解析，保留 SSRF 校验。
FEED_DNS_OVER_HTTPS=false
# 打开上面那项时用哪家 DoH（逗号分隔、按顺序试）。默认「阿里 → Cloudflare」：海外的解析器
# 会给国内站点一个"给海外客户"的 CDN 边缘，那种边缘常回 403/522，会让健康检查变成「未能确认」。
# FEED_DNS_DOH=https://dns.alidns.com/resolve

# ───────────────────────── 评论 ─────────────────────────
# 同一访客两次评论的最小间隔（毫秒），下限 0、上限 1 小时。
# COMMENT_MIN_ELAPSED_MS=3000
# 「填过邮箱自动回填昵称/网址」的三层限额（同一窗口，默认 10 分钟）：单邮箱、单 IP 的不同邮箱数、
# 全站新邮箱数。挡住拿这个接口枚举「哪些邮箱在本站留过言」；改大即放宽，改小可能影响共用出口的读者。
# READER_PROBE_WINDOW_MS=600000
# READER_PROBE_PER_EMAIL=6
# READER_PROBE_PER_IP=12
# READER_PROBE_GLOBAL=300

# ───────────────────────── 友链 ─────────────────────────
# 0 关闭自动检查，下限 30 分钟。
# LINK_CHECK_MS=21600000

# ───────────────────────── 备份 ─────────────────────────
BACKUP_ON_PUBLISH=true
BACKUP_INTERVAL_MS=21600000
# 保留多少份完整备份（0 = 不自动删）。
BACKUP_KEEP=7
# 整包与单文件上限（默认 512MB / 256MB，足够容纳 128MB 视频）。
# MAX_BACKUP_BYTES=536870912
# MAX_BACKUP_FILE_BYTES=268435456
# 异地备份二选一：rsync 目标，或每个文件执行一次的自定义命令（{} 替换为文件路径）。
# BACKUP_REMOTE=user@host:/path/to/backups
# 异地目录与本地**镜像同步**：本地按 BACKUP_KEEP 保留、资产包按引用计数回收，异地照抄这一份。
# 内容哈希命名的资产包在两边名字一致，没变更时 rsync 直接跳过，不再每次重传几十 MB。
# （旧变量 BACKUP_REMOTE_KEEP_DAYS 已废弃：镜像语义下保留份数只由 BACKUP_KEEP 决定。）
# BACKUP_HOOK='rclone copy {} remote:blog'
# 备份/恢复用的临时目录（默认取 TMPDIR，再回落 /tmp）。放独立磁盘可避免备份时把系统盘写满。
# BLOG_TMP_DIR=/var/tmp/blog

# ───────────────────────── 邮件 ─────────────────────────
# 也可在后台「设置」里填写；后台值优先于环境变量。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_TLS=ssl              # ssl | starttls | none
# SMTP_SECURE=true          # 旧变量：true=ssl、false=starttls；新配置请用 SMTP_TLS
# SMTP_USER=you@example.com
# SMTP_PASS=授权码
# MAIL_FROM=博客 <you@example.com>
# OWNER_EMAIL=you@example.com
# 非生产环境把未发出的邮件正文打到控制台（签名链接与邮箱会打码）。
# MAIL_DEBUG=false
# 通知队列：全局每小时最多发多少封（默认 30），以及重试扫描间隔（默认 60 秒）。
# MAIL_MAX_PER_HOUR=30
# MAIL_RETRY_INTERVAL_MS=60000

# ───────────────────────── 头像 ─────────────────────────
# 逗号分隔、按顺序尝试；留空 = 关闭回源，只用字母头像。
# AVATAR_UPSTREAMS=https://secure.gravatar.com/avatar,https://cravatar.cn/avatar,https://gravatar.loli.net/avatar

# ───────────────────────── 回收站 ─────────────────────────
# 原图保留天数；派生图（缩略图/响应式变体）单独用更短的天数。
# TRASH_KEEP_DAYS=90
# TRASH_DERIVED_KEEP_DAYS=7

# ───────────────────── 监控（npm run monitor）─────────────────────
# /healthz 只对带此 token 的请求返回备份年龄等内部字段；匿名只回 { ok, posts, uptimeSec }。
# 生产环境不配 token 就拿不到备份字段，监控会一直报「读不到备份状态」。
# MONITOR_TOKEN=换成一串随机值
# MONITOR_URL=https://example.com/healthz
# MONITOR_BACKUP_MAX_AGE_SEC=172800
# 健康检查的磁盘/WAL 阈值：低于剩余空间或 WAL 超过上限时 /healthz 返回 ok:false。
# HEALTH_MIN_DISK_FREE_BYTES=536870912
# HEALTH_MAX_WAL_BYTES=536870912
# HEALTH_BACKUP_TIMEOUT_SEC=1200
# 生产机自己不推异地、由另一台机器 pull 时：指向本机拉取目录，
# 探针会直接看最新清单年龄；此时 MONITOR_REQUIRE_OFFSITE 保持 false。
# MONITOR_OFFSITE_DIR=/absolute/path/to/offsite-backups
# MONITOR_REQUIRE_OFFSITE=false
# MONITOR_STATE_FILE=data/monitor-state.json
# MONITOR_WEBHOOK_URL=https://example.com/webhook
# 走站点自己的 SMTP 发告警（复用后台「设置」里那套，状态变化时才发）。
# MONITOR_MAIL=true
# 进程内看门狗：生产默认 5 分钟探一次自己的公网 /healthz；0 关闭。
# WATCHDOG_INTERVAL_MS=300000

# ───────────────────── 日志轮转（npm run rotate:logs）─────────────────────
# 仅文件日志模式需要；systemd 部署走 journald，由系统轮转。
# 默认超过 5MB 切一份、留 5 份；服务进程内每小时也会检查一次，0 关闭。
# LOG_MAX_MB=5
# LOG_KEEP=5
# LOG_ROTATE_INTERVAL_MS=3600000
# BLOG_LOG_DIR=~/.local/share/blog-hosting

# ───────────────── 测试与工具（不要写进生产 .env）─────────────────
# 生产默认精简 CSS/JS（NODE_ENV=production 时开）；设 0 可强制发源码，便于线上排错。
# SERVE_MINIFIED=0
# UI_AUDIT=off
# UI_AUDIT_REQUIRED=1
# UI_AUDIT_PASSWORD=...
# UI_REVIEW_SHOTS=1
