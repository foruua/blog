{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "单栏极简 · 功能不简单的个人独立博客（Hono + node:sqlite）",
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "build:assets": "node scripts/build-assets.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "backup:list": "node --env-file-if-exists=.env scripts/backup.mjs --list",
    "offsite:pull": "bash scripts/pull-offsite.sh",
    "backfill-media": "node --env-file-if-exists=.env scripts/backfill-media.mjs",
    "drill": "node --env-file-if-exists=.env scripts/restore-drill.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "set-password": "node --env-file-if-exists=.env scripts/set-password.mjs",
    "test:media": "node scripts/test-media.mjs",
    "test:media-browser": "node scripts/test-media-browser.mjs",
    "test:comments": "node scripts/test-comments.mjs",
    "test:avatar": "node scripts/test-avatar.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:themes": "node scripts/test-themes.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:feeds": "node scripts/test-feeds.mjs",
    "test:feed-dns": "node scripts/test-feed-dns.mjs",
    "test:links": "node scripts/test-links.mjs",
    "test:friends-links": "node scripts/test-friends-links-improvements.mjs",
    "test:minify": "node scripts/test-minify.mjs",
    "test:hero-a11y": "node scripts/test-hero-a11y.mjs",
    "test:audit-browser": "node scripts/test-audit-browser.mjs",
    "test:deploy-release": "node scripts/test-deploy-release.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:p2": "node scripts/test-p2.mjs",
    "test": "node scripts/test-all.mjs",
    "test:only": "node scripts/test-all.mjs --only",
    "test:pjax": "node scripts/test-pjax.mjs",
    "test:palette": "node scripts/test-palette.mjs",
    "test:mail": "node scripts/test-mail.mjs",
    "test:mail-queue": "node scripts/test-mail-queue.mjs",
    "test:health": "node scripts/test-health.mjs",
    "test:page-cache": "node scripts/test-page-cache.mjs",
    "preview:mail": "node --env-file-if-exists=.env scripts/preview-mail.mjs",
    "test:regressions": "node scripts/test-regressions.mjs",
    "clear:demo": "node --env-file-if-exists=.env scripts/clear-demo.mjs",
    "seed:comments": "node --env-file-if-exists=.env scripts/seed-comments.mjs",
    "clear:comments": "node --env-file-if-exists=.env scripts/seed-comments.mjs --clear",
    "test:hardening": "node scripts/test-hardening.mjs",
    "test:ui": "node scripts/ui-audit.mjs --isolate",
    "audit:ui": "node scripts/ui-audit.mjs",
    "pretest": "npm run lint",
    "lint": "eslint .",
    "test:review": "node scripts/test-review.mjs",
    "monitor": "node --env-file-if-exists=.env scripts/monitor.mjs",
    "rotate:logs": "node scripts/rotate-logs.mjs",
    "test:popup-buttons": "node scripts/test-popup-buttons.mjs",
    "test:dialog-scroll": "node scripts/test-dialog-scroll.mjs",
    "test:lightbox": "node scripts/test-lightbox.mjs",
    "test:ui-contract": "node scripts/test-ui-contract.mjs",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:maintenance": "node scripts/test-maintenance.mjs",
    "test:monitor": "node scripts/test-monitor.mjs",
    "audit:deps": "npm audit --omit=dev --registry=https://registry.npmjs.org --audit-level=moderate",
    "test:ui-improvements": "node scripts/test-ui-improvements.mjs",
    "test:background": "node scripts/test-background.mjs",
    "test:operations": "node scripts/test-operations.mjs",
    "cleanup:media": "node --env-file-if-exists=.env scripts/cleanup-media.mjs",
    "cleanup:trash": "node --env-file-if-exists=.env scripts/cleanup-trash.mjs",
    "cleanup:output": "node scripts/cleanup-output.mjs",
    "sync:content": "node --env-file-if-exists=.env scripts/sync-content.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "js-yaml": "^4.1.0",
    "liquidjs": "^10.30.0",
    "markdown-it": "^14.3.3",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "css-tree": "^3.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0"
  }
}
