# —— 私有状态与运行时数据：不进源码仓库 ——
.env
.env.*
!.env.example
/data/
/state/
/backups/
/content/
/output/
*.blog-lock/
.app-secret
# 私钥与证书：部署/异地备份用的 pem、key 绝不能被误提交
*.pem
*.key
*.pre-restore-*
.blog-restore-*
themes/.trash/
themes/.install-*
themes/.replace-*
public/.build/
# build:assets 从 style.css 切片生成的页面级样式表（部署时在服务器上重建）
/public/style-lite.css
/public/style-article.css
# 前台 5 个脚本的构建期合并产物（部署时在服务器上重建）
/public/site.js

# —— 依赖与工具产物 ——
node_modules/
.DS_Store
.workbuddy/
.workbuddy-ai/
# 锚定到 docs/ 下：以前写成 design/，任何目录里叫 design 的文件夹（包括未来真的设计稿目录）
# 都会被忽略，而 eslint 里那份对应的 'design/**' 又指向一个不存在的路径。
/docs/design/

# —— 编辑器 / 系统杂项 ——
.vscode/
.idea/
*.swp
.sandbox-overlay/
# Trae 分享方案页时生成的 zip 打包产物：随时可由 docs/*.html 重新生成
.trae-html-share-packages/
